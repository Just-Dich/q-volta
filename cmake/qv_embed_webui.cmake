# Generates webui_assets.cpp from the vendored, pre-gzipped llama.cpp web UI (src/server/webui/gzip).
# Same table layout as llama.cpp's scripts/ui-assets.cmake: name, bytes, size, ETag (quoted SHA-256 of the served bytes), MIME type.
# Usage: cmake -DWEBUI_DIR=<dir> -DOUT=<file.cpp> -P qv_embed_webui.cmake
cmake_minimum_required(VERSION 3.18)

function(mime_from_ext name out_var)
  string(FIND "${name}" "." p REVERSE)
  set(e "")
  if(p GREATER -1)
    math(EXPR p "${p}+1")
    string(SUBSTRING "${name}" ${p} -1 e)
  endif()
  set(m "application/octet-stream")
  if(e STREQUAL "html")
    set(m "text/html; charset=utf-8")
  elseif(e STREQUAL "css")
    set(m "text/css")
  elseif(e STREQUAL "js" OR e STREQUAL "mjs")
    set(m "application/javascript")
  elseif(e STREQUAL "json")
    set(m "application/json")
  elseif(e STREQUAL "webmanifest")
    set(m "application/manifest+json")
  elseif(e STREQUAL "svg")
    set(m "image/svg+xml")
  elseif(e STREQUAL "png")
    set(m "image/png")
  elseif(e STREQUAL "jpg" OR e STREQUAL "jpeg")
    set(m "image/jpeg")
  elseif(e STREQUAL "ico")
    set(m "image/x-icon")
  elseif(e STREQUAL "woff")
    set(m "font/woff")
  elseif(e STREQUAL "woff2")
    set(m "font/woff2")
  endif()
  set(${out_var} "${m}" PARENT_SCOPE)
endfunction()

file(GLOB_RECURSE assets LIST_DIRECTORIES false RELATIVE "${WEBUI_DIR}" "${WEBUI_DIR}/*")
list(SORT assets)
list(LENGTH assets n)
if(n EQUAL 0)
  message(FATAL_ERROR "no web UI assets in ${WEBUI_DIR}")
endif()

set(arrays "")
set(table "")
set(idx 0)
foreach(f IN LISTS assets)
  file(READ "${WEBUI_DIR}/${f}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  file(SHA256 "${WEBUI_DIR}/${f}" etag)
  mime_from_ext("${f}" mime)
  string(APPEND arrays "static const unsigned char asset_${idx}[] = {${bytes}};\n")
  string(APPEND table "    { \"${f}\", asset_${idx}, sizeof(asset_${idx}), \"\\\"${etag}\\\"\", \"${mime}\" },\n")
  math(EXPR idx "${idx}+1")
endforeach()

set(content "// Generated by cmake/qv_embed_webui.cmake - do not edit. llama.cpp web UI, gzip-compressed (see src/server/webui/README.md).
#include \"server/webui.h\"

namespace qv::server {
${arrays}
static const WebuiAsset g_assets[] = {
${table}};
const WebuiAsset* webui_assets(size_t* n) { *n = ${n}; return g_assets; }
}  // namespace qv::server
")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
